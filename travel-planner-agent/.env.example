# IBM Cloud Configuration
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key
IBM_CLOUD_AUTH_URL=https://iam.cloud.ibm.com/identity/token

# IBM Granite (Watsonx) Configuration
WATSONX_PROJECT_ID=your_project_id
WATSONX_AUTH_URL=https://iam.cloud.ibm.com/identity/token
WATSONX_API_URL=https://us-south.ml.cloud.ibm.com

# IBM Watson Services
WATSON_ASSISTANT_API_KEY=your_watson_assistant_key
WATSON_ASSISTANT_URL=https://api.us-south.assistant.watson.cloud.ibm.com

# Travel API Keys (Third-party integrations)
OPENWEATHER_API_KEY=your_openweather_key
GOOGLE_MAPS_API_KEY=your_google_maps_key
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Database (Optional)
DATABASE_URL=mongodb://localhost:27017/travel-planner

# Cache Configuration
REDIS_URL=redis://localhost:6379
